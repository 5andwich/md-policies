{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/compliance-policy.schema.json",
  "title": "Compliance Policy",
  "type": "object",
  "required": [
    "policy_id",
    "title",
    "version",
    "framework",
    "domain",
    "control_mappings",
    "policy_logic"
  ],
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "retired"]
    },
    "framework": {
      "type": "object",
      "required": ["name", "artifact", "control_family"],
      "properties": {
        "name": { "type": "string" },
        "artifact": { "type": "string" },
        "baseline": { "type": "string" },
        "control_family": { "type": "string" }
      }
    },
    "domain": {
      "type": "string"
    },
    "control_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["control_id", "control_name"],
        "properties": {
          "control_id": { "type": "string" },
          "control_name": { "type": "string" },
          "parameters": {
            "type": "array",
            "items": { "type": "string" }
          },
          "supplemental_guidance": { "type": "string" }
        }
      }
    },
    "policy_logic": {
      "type": "object",
      "required": ["effect", "conditions", "actions"],
      "properties": {
        "effect": {
          "type": "string",
          "enum": ["allow", "deny", "require"]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "expression"],
            "properties": {
              "id": { "type": "string" },
              "expression": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["low", "moderate", "high", "critical"]
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "description"],
            "properties": {
              "type": { "type": "string" },
              "description": { "type": "string" },
              "automation_target": { "type": "string" }
            }
          }
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "review_cadence": {
      "type": "string"
    },
    "owners": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
